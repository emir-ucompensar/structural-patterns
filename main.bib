@Comment{
  main.bib - Bibliography entries for the APA7 paper template.

  Store references in BibTeX format. Use lowercase ASCII kebab-case keys and
  keep APA 7 article fields explicit so entries are easy to review and complete.
}

@Comment{
  APA 7 journal article template. Uncomment and fill every available field
  before citing it in the paper.

  @article{reference-key,
    author  = {},
    year    = {},
    title   = {},
    journal = {},
    pages   = {},
    doi     = {},
    url     = {}
  }
}
